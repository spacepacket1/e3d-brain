{
  "name": "e3d-brain",
  "version": "0.1.1",
  "description": "Local-first, auditable MCP memory server over a plain-Markdown Obsidian vault",
  "license": "MIT",
  "author": "Chris Bloom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spacepacket1/e3d-brain.git"
  },
  "homepage": "https://github.com/spacepacket1/e3d-brain#readme",
  "bugs": {
    "url": "https://github.com/spacepacket1/e3d-brain/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "obsidian",
    "markdown",
    "claude",
    "agents"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ebrain": "dist/src/cli/main.js",
    "e3d-brain": "dist/src/cli/main.js"
  },
  "files": [
    "dist/src",
    "docs/SETUP.md",
    "docs/SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:native": "npm rebuild better-sqlite3",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-sqlite3": "13.0.3",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/yauzl": "3.4.0",
    "typescript": "6.0.3"
  }
}
