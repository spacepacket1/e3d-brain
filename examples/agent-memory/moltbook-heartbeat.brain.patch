+// ── Memory (optional): an e3d-brain journal instance for this agent ────────────
+// Off unless BRAIN_CONFIG is set, so behaviour is unchanged by default. The client never throws and fails open:
+// if the brain is down the heartbeat just runs without memory. Recalled text is advisory only (see agent-brain.mjs).
+let brain = null;
+async function initBrain() {
+  if (!process.env.BRAIN_CONFIG || !process.env.BRAIN_MAIN) return;
+  try {
+    const { AgentBrain } = await import(process.env.BRAIN_CLIENT || '/Users/mini/e3d-brain/examples/agent-memory/agent-brain.mjs');
+    brain = await AgentBrain.open({ main: process.env.BRAIN_MAIN, config: process.env.BRAIN_CONFIG });
+    console.log(brain.disabled ? `[heartbeat] brain unavailable (${brain.reason}); running without memory` : '[heartbeat] brain memory on');
+  } catch (e) {
+    console.warn('[heartbeat] brain init failed; running without memory:', e.message);
+  }
+}
+async function recallBlock(query) {
+  if (!brain || brain.disabled) return '';
+  const { promptBlock } = await import(process.env.BRAIN_CLIENT || '/Users/mini/e3d-brain/examples/agent-memory/agent-brain.mjs');
+  return promptBlock(await brain.recall(query, { limit: 3, maxChars: 3000 }));
+}
+async function rememberPost({ kind, theirs, ours, mapsContext, postId }) {
+  if (!brain || brain.disabled || DRY_RUN) return;
+  const top = buildSignalContext(mapsContext).top_signal;
+  const sig = top ? `${top.signal_type || 'signal'} ${top.origin || '?'} to ${top.destination || '?'}, confidence ${top.confidence_pct}%, horizon ${top.time_horizon_hours ?? '?'}h` : 'no live signal';
+  await brain.remember({
+    title: `${kind === 'reply' ? 'Replied to a comment' : 'Commented on a feed post'} (${new Date().toISOString().slice(0, 16)}Z)`,
+    body: `Signal: ${sig}\nWhat they said (untrusted): ${String(theirs).slice(0, 400)}\nWhat I said: ${String(ours).slice(0, 600)}`,
+    kind: 'decision',
+    // third-party text: tagged untrusted, which the brain requires to cite a source
+    untrusted: true,
+    sources: [`url:https://www.moltbook.com/post/${encodeURIComponent(String(postId))}`],
+  });
 }
 
